{
    "name": "@lessxi/dsh-prompt-optimizer",
    "version": "0.4.8",
    "description": "DSH Web 输入框接管：发送前用独立 AI 把提示词优化成可直接发给工作 AI 的命令（传话者语义、四档强度、审查/自动发送、可拖动改尺寸迷你窗、按会话隔离的档位与发送方式、优化结果一键复制、优化前后同屏对照、极端档只读查证仅用于消歧）",
    "type": "module",
    "main": "./lib/index.js",
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md",
        "ACCEPTANCE.md",
        "LICENSE",
        "CHANGELOG.md",
        "README.en.md"
    ],
    "keywords": [
        "dsh",
        "dsh-plugin",
        "prompt",
        "prompt-optimizer",
        "llm",
        "web"
    ],
    "license": "BSD-3-Clause",
    "peerDependencies": {
        "@deepseek-ai/dsh-llm": "*",
        "@deepseek-ai/dsh-client-ui-slots": "*",
        "cordis": "*"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-llm": {
            "optional": true
        },
        "@deepseek-ai/dsh-client-ui-slots": {
            "optional": true
        },
        "cordis": {
            "optional": true
        }
    },
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-runtime",
                "@deepseek-ai/dsh-client-ui-slots"
            ],
            "platform": "web"
        }
    }
}
